# Copy to .env.local and adjust. Only VITE_* variables reach the browser: never put secrets here.

# The ATC API. Default "/api", which the dev server proxies to http://localhost:8000 (set ATC_API to change that).
VITE_API_URL=
# "true" shows the maintenance page to everyone.
VITE_MAINTENANCE=false
# A badge in the top bar: "Staging", "Local". Leave empty on production.
VITE_ENVIRONMENT=
# Base map tiles: empty = OpenFreeMap (OpenStreetMap data, no key, no SLA), a TileJSON URL of your own tile server, or "off".
VITE_MAP_TILES=
